<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks><LangVersion>latest</LangVersion><NoWarn>$(NoWarn);SYSLIB0050</NoWarn></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Optimizations/InventoryScratch.cs" Link="InventoryScratch.cs" />
    <Compile Include="../../Optimizations/BarterWritebackPatch.cs" Link="BarterWritebackPatch.cs" />
    <Compile Include="../../Optimizations/SaveRemainingIdsPatch.cs" Link="SaveRemainingIdsPatch.cs" />
    <Compile Include="../../Optimizations/ContainedItemRemovalPatch.cs" Link="ContainedItemRemovalPatch.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Managed)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'"><Compile Remove="AllocationOnlyProgram.cs" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'"><Compile Remove="Program.cs;RemainingChecks.cs;RemovalChecks.cs" /></ItemGroup>
</Project>

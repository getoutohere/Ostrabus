<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Ostrabus</AssemblyName>
    <RootNamespace>Ostrabus</RootNamespace>
    <Product>Ostrabus</Product>
    <Version>0.3.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/Ostrabus</PathMap>
    
    <!-- Match this exactly to your Ostranauts installation folder -->
  </PropertyGroup>

  <!-- Local Game and Unity Engine References -->
  <ItemGroup><Reference Include="Vectrosity"><HintPath>$(Managed)/Vectrosity.dll</HintPath><Private>False</Private></Reference></ItemGroup>
  <ItemGroup><Compile Remove="Tests/**/*.cs;Tools/**/*.cs;Build/**/*.cs;CustomBuilder/**/*.cs" /></ItemGroup>
  <ItemGroup>
    <None Update="PdaSettings/Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="NavConsole/Assets/RoundKnob-v3.png" LogicalName="Ostrabus.NavConsole.RoundKnob.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(GameDir)')">
    <!-- Main Game Code -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDir)\Ostranauts_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Ostranauts_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- Unity Core Modules -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Ostranauts_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Ostranauts_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(Managed)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(Managed)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
        <Reference Include="UnityEngine.UI">
      <HintPath>$(Managed)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(Managed)/UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(Managed)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Managed)/Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(Managed)/Unity.InputSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Local BepInEx and Harmony Engine References -->
  <ItemGroup Condition="Exists('$(GameDir)')">
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>


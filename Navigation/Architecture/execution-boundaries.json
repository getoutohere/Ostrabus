  "invariants": [
    {"id":"single_movement_authority","rule":"An adopted actor has one current mission/ability generation controlling engine inputs and route ownership; world forces remain native."},
    {"id":"explicit_handoff","rule":"Revoke obsolete controls before granting the next ability; native OnExit is not a complete cancellation interface."},
    {"id":"mission_owned_goal","rule":"An interrupted mission retains a logical target/frame independent of ship-global goal fields; resume revalidates it."},
    {"id":"typed_outcomes","rule":"Failure, interruption and waiting are not successful phase completion; native reactive/skip semantics remain explicit."},
    {"id":"durable_progress","rule":"Mission/ability identity, cursor, callback lifetime and shared fuel state survive reload; transient caches are separate."},
    {"id":"interval_accounting","rule":"Supported deterministic travel consumes each time/fuel interval once and propagates residual time after phase completion."},
    {"id":"acknowledged_world_effects","rule":"Native docking/retirement/transfer effects require readback before another action; local tokens alone do not prove exactly-once world effects."},
    {"id":"canonical_binding","rule":"Logical reconstruction and actor/hull reuse are distinct; runtime bindings and generations reject stale events."}
  ],

  "decision": "Replace command execution and mission lifecycle behind native role policy and native world services; prototype offline first.",
  "firstLifecycle": ["patrol", "encounter", "native_combat_or_surrender_or_retreat", "home_approach", "native_arrival_and_parking"],
  "preservedPolicy": ["native_role_tree_ordered_choices", "native_asset_conditions_interactions_and_command_loot", "faction_sensor_and_engagement_rules", "existing_optional_reserve_policy", "fuel_tolerant_shallow_travel", "current_bulk_combat_exclusions", "native_crew_and_station_lifecycle"],
